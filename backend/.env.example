# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/production_tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=12h

# Server
PORT=3001

# Public base URL (used to build absolute file URLs in exports/emails if needed)
PUBLIC_URL=http://localhost:3001

# Image storage driver: "local" (default) or "cloudinary"
STORAGE_DRIVER=local

# Cloudinary (only used if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=production_tracker
