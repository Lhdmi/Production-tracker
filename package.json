{
  "name": "production-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Application mobile PWA de gestion de production et suivi de poids avec gestion d'anomalies",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "db:push": "npm --workspace backend run db:push",
    "db:seed": "npm --workspace backend run db:seed",
    "start": "npm --workspace backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "engines": {
    "node": ">=18.11.0"
  }
}
